:root {
    /* Palette */
    --color-accent: #3482dd;
    --color-accent-soft: rgba(76, 224, 232, 0.28);
    --color-danger: #ff543e;
    --color-danger-edge: rgba(255, 84, 62, 0.34);
    --color-slow-edge: rgba(108, 200, 255, 0.24);

    --color-white: #ffffff;
    --color-white-75: rgba(255, 255, 255, 0.75);

    --color-overlay-pause: rgba(16, 33, 64, 0.67);
    --color-overlay-death: rgba(32, 26, 54, 0.79);
    --color-black: #05070a;

    /* Font slot вЂ” swap to a custom FontAsset anytime:
       --font-main: url("project://database/Assets/Fonts/Inter.asset"); */

    /* Typography */
    --font-size-ammo: 27px;
    --font-size-micro: 11px;
    --tracking-label: 0.4px;

    /* Radii & Borders */
    --radius-pill: 99px;
    --border-thin: 1px;

    /* Spacing */
    --space-sm: 10px;
    --space-lg: 28px;

    /* Durations */
    --dur-fast: 150ms;
    --dur-mid: 240ms;
    --dur-slow: 380ms;

    /* Element sizes */
}

/* ==========================================================================
   ROOT & SCREEN TRANSITIONS
   ========================================================================== */

.ui-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--color-white);
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: var(--dur-mid), var(--dur-mid);
    transition-timing-function: ease-out, ease-out;
}

.screen--hidden {
    opacity: 0;
    translate: 0 12px;
    visibility: hidden;
}

.screen--death {
    transition-duration: var(--dur-slow), var(--dur-slow);
}

/* Full-screen non-blocking edge vignettes (critical time & slow) */
.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    border-width: 24px;
    border-radius: 0;
    transition-property: opacity;
    transition-duration: var(--dur-mid);
    transition-timing-function: ease-out;
}

.vignette--danger {
    border-color: var(--color-danger-edge);
}

.vignette--slow {
    border-color: var(--color-slow-edge);
}

.vignette--active {
    opacity: 1;
}

/* ==========================================================================
   1. HUD вЂ” TIME BAR (TOP CENTER)
   ========================================================================== */

.hud-root {
    padding: var(--space-lg);
}

.time-wrapper {
    position: absolute;
    top: 22px;
    left: 22px;
    width: 308px;
    max-width: 56%;
    scale: 1 1;
    transition-property: scale, border-color;
    transition-duration: var(--dur-fast), var(--dur-mid);
}

.time-wrapper--gain {
    scale: 1.035 1.035;
    border-color: var(--color-accent);
}

.time-wrapper--danger {
    border-color: var(--color-danger);
}

.time-header {
    width: 100%;
    min-height: 26px;
}

.micro-label {
    font-size: var(--font-size-micro);
    color: var(--color-white-75);
    letter-spacing: var(--tracking-label);
    margin: 0;
    padding: 0;
}

.time-gain-chevron {
    font-size: 16px;
    color: #cafea5;
    -unity-font-style: bold;
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--dur-mid);
}

.time-gain-chevron--show {
    opacity: 1;
}

.time-track {
    height: 16px;
    margin-top: 7px;
    margin-bottom: 7px;
    margin-left: 8px;
    margin-right: 8px;
    position: relative;
}

.time-trail {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
    background-color: #b8cbe5;
}

.time-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 100%;
    background-color: #72bd4c;
    -unity-background-image-tint-color: #8cde56;
}

.time-fill--gain {
    -unity-background-image-tint-color: #d5fc97;
}

.time-fill--danger {
    -unity-background-image-tint-color: #fb944d;
}

.time-fill--hit-flash {
    -unity-background-image-tint-color: #fc6550;
}

.time-cap-notch {
    position: absolute;
    right: 0;
    top: -3px;
    bottom: -3px;
    width: 2px;
    background-color: var(--color-white-75);
}

/* Subtle SLOWED chip below time bar */
.slow-chip {
    display: none;
    align-self: flex-start;
    margin: 0 8px 7px 8px;
    padding: 3px 6px;
    border-width: 1px;
    border-color: #7594c3;
    border-radius: 3px;
    color: #244b8c;
    background-color: #e3edfb;
    font-size: 11px;
    -unity-font-style: bold;
}

.slow-chip--active {
    display: flex;
}

/* Slim digit-free Boss health bar under the Time Bar */
.boss-bar-wrapper {
    margin: 0 8px 8px 8px;
    border-top-width: 1px;
    border-top-color: #aeb9cd;
    padding-top: 5px;
}

.boss-bar-label {
    color: #a63032;
    margin-bottom: 3px;
}

.boss-bar-track {
    height: 8px;
    background-color: #d3dae6;
    overflow: hidden;
}

.boss-bar-fill {
    width: 100%;
    height: 100%;
    background-color: #c64b49;
    transition-property: width;
    transition-duration: var(--dur-fast);
}

/* ==========================================================================
   2. HUD вЂ” AMMO (BOTTOM RIGHT)
   ========================================================================== */

.ammo-panel {
    position: absolute;
    right: 22px;
    bottom: 22px;
    width: 205px;
    max-width: 48%;
}

.ammo-body {
    padding: 3px 8px 5px 8px;
}

.ammo-panel--empty .ammo-body {
    display: none;
}

.ammo-magazine-size {
    color: #415579;
    font-size: 13px;
    margin: 3px 0 0 2px;
}

.ammo-bottom-row {
    flex-direction: row;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: #c8c2b4;
    min-height: 16px;
}

.ammo-reserve {
    color: #455674;
    font-size: 11px;
}

.ammo-top-row {
    flex-direction: row;
    align-items: center;
}

.ammo-pips {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin-right: 7px;
}

.ammo-pip {
    width: 8px;
    height: 15px;
    margin-right: 3px;
    background-color: #4681c4;
    border-width: 1px;
    border-color: #7eaddf #235381 #235381 #7eaddf;
    border-radius: 2px;
    transition-property: background-color;
    transition-duration: var(--dur-fast);
}

.ammo-pip--spent {
    background-color: #d7d9d8;
    border-color: #ccd0d6;
    opacity: 1;
}

.ammo-pip--reloading {
    background-color: #83c454;
    border-color: #529333;
}

.ammo-count {
    font-size: var(--font-size-ammo);
    color: #18395f;
    min-width: 33px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
    transition-property: scale, color;
    transition-duration: var(--dur-fast), var(--dur-fast);
}

.ammo-count--punch {
    scale: 1.24 1.24;
    color: var(--color-accent);
}

.ammo-count--empty {
    color: var(--color-danger);
}

.reload-hint {
    color: #a23528;
    font-size: 11px;
    -unity-font-style: bold;
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--dur-fast);
}

/* ==========================================================================
   3. HUD вЂ” CROSSHAIR & HIT MARKER (CENTER)
   ========================================================================== */

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    align-items: center;
    justify-content: center;
    scale: 1 1;
    transition-property: scale;
    transition-duration: var(--dur-fast);
    transition-timing-function: ease-out;
}

.crosshair--fired {
    scale: 1.45 1.45;
}

.crosshair--aiming {
    scale: 0.72 0.72;
}

.crosshair-dot {
    width: 4px;
    height: 4px;
    border-radius: var(--radius-pill);
    background-color: var(--color-white);
    transition-property: background-color;
    transition-duration: var(--dur-fast);
}

.crosshair-arm {
    position: absolute;
    background-color: var(--color-white-75);
    border-radius: 1px;
    transition-property: background-color, translate;
    transition-duration: var(--dur-fast), var(--dur-fast);
    transition-timing-function: ease-out, ease-out;
}

.crosshair-arm--top    { width: 2px; height: 6px; translate: 0 -9px; }
.crosshair-arm--bottom { width: 2px; height: 6px; translate: 0 9px; }
.crosshair-arm--left   { width: 6px; height: 2px; translate: -9px 0; }
.crosshair-arm--right  { width: 6px; height: 2px; translate: 9px 0; }

.crosshair--enemy .crosshair-dot,
.crosshair--enemy .crosshair-arm {
    background-color: var(--color-danger);
}

/* Brief 4-tick hit marker */
.hit-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.8 0.8;
    transition-property: opacity, scale;
    transition-duration: 120ms, 120ms;
    transition-timing-function: ease-out, ease-out;
}

.hit-marker--show {
    opacity: 1;
    scale: 1.1 1.1;
}

.hit-tick {
    position: absolute;
    width: 9px;
    height: 2px;
    background-color: var(--color-white);
    border-radius: 1px;
}

.hit-tick--tl { translate: -9px -9px; rotate: 45deg; }
.hit-tick--tr { translate: 9px -9px;  rotate: -45deg; }
.hit-tick--bl { translate: -9px 9px;  rotate: -45deg; }
.hit-tick--br { translate: 9px 9px;   rotate: 45deg; }

/* ==========================================================================
   4. HUD вЂ” BUFF LIST (TOP RIGHT)
   ========================================================================== */

.buff-list {
    position: absolute;
    top: var(--space-lg);
    right: var(--space-lg);
    flex-direction: column;
    align-items: flex-end;
}

.buff-chip {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    margin-bottom: 5px;
    background-color: #f2eddd;
    border-width: 1px;
    border-color: #3d6caa;
    border-radius: 4px;
    transition-property: opacity, translate;
    transition-duration: var(--dur-mid), var(--dur-mid);
}

.buff-chip--enter {
    opacity: 0;
    translate: 28px 0;
}

.buff-icon {
    width: 20px;
    height: 20px;
    margin-right: var(--space-sm);
    border-radius: 5px;
    background-color: var(--color-accent-soft);
    border-width: var(--border-thin);
    border-color: var(--color-accent);
    -unity-background-scale-mode: scale-to-fit;
}

.buff-name {
    color: #244367;
    font-size: 13px;
}

/* ==========================================================================
   5. OVERLAY SCREENS (PAUSE, TIME'S UP, ESCAPED)
   ========================================================================== */

.overlay-pause {
    background-color: var(--color-overlay-pause);
    align-items: center;
    justify-content: center;
}

.overlay-death {
    background-color: var(--color-overlay-death);
    align-items: center;
    justify-content: center;
}

.overlay-escape {
    background-color: var(--color-black);
    align-items: center;
    justify-content: center;
}

.modal-card {
    width: 420px;
    max-width: 94%;
    max-height: 94%;
}

.window-titlebar {
    min-height: 34px;
    padding-left: 11px;
}

.window-titlebar .retro-title {
    font-size: 16px;
}

.window-body {
    padding: 17px;
}

.button-row {
    flex-direction: row;
}

.ui-button {
    min-height: 38px;
    margin: 3px 0;
    font-size: 14px;
    white-space: normal;
}

.button-row .ui-button {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 3px;
    margin-right: 3px;
}

.window-footer {
    margin: 11px 1px 0 1px;
    padding: 8px 0 0 0;
    border-top-width: 1px;
    border-top-color: #c8c1af;
    color: #4b5d79;
    font-size: 11px;
    -unity-text-align: middle-right;
}

.dialog-status {
    margin: 1px 0 14px 0;
    color: #18395f;
    font-size: 21px;
    -unity-font-style: bold;
}

.dialog-status--danger {
    color: #a0352f;
}

.escape-line {
    color: #18395f;
    margin: 2px 0 7px 0;
    font-size: 22px;
    -unity-font-style: bold;
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--dur-slow);
}

.escape-line--sub {
    color: #445678;
    font-size: 14px;
    -unity-font-style: normal;
    margin-bottom: 14px;
}

.escape-actions {
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--dur-slow);
}

.escape-line--visible,
.escape-actions--visible {
    opacity: 1;
}

.hidden-display {
    display: none;
}

.modal-card--settings {
    width: 460px;
}

.settings-list {
    background-color: #f9f6ed;
    border-width: 1px;
    border-color: #9daec2 #fffefa #fffefa #9daec2;
    border-radius: 3px;
    padding: 4px 12px;
    margin-bottom: 8px;
}

.settings-row {
    padding-top: 8px;
    padding-bottom: 6px;
}

.settings-row-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.settings-row-header .micro-label {
    color: #253656;
    font-size: 13px;
}

.settings-value {
    font-size: 13px;
    color: #235cac;
    -unity-font-style: bold;
}

.settings-slider {
    width: 100%;
    margin: 0;
}

.settings-slider .unity-base-slider__tracker {
    height: 5px;
    background-color: #c3cfdb;
    border-width: 1px;
    border-color: #8195ae #fdfefe #fdfefe #8195ae;
    border-radius: 2px;
}

.settings-slider .unity-base-slider__dragger {
    width: 13px;
    height: 17px;
    background-color: #eaf4ff;
    border-width: 1px;
    border-color: #4072b4;
    border-radius: 3px;
}
