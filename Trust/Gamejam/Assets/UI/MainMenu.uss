.menu-screen {
    flex-grow: 1;
    justify-content: center;
    padding-left: 7%;
    padding-right: 7%;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(9, 18, 37, 0.18);
}

.menu-window {
    width: 444px;
    max-width: 100%;
    flex-shrink: 0;
}

.menu-titlebar {
    height: 32px;
}

.menu-body {
    padding: 26px 34px 20px 34px;
    background-color: #f0eddf;
    border-top-width: 2px;
    border-top-color: #fcfdff;
}

.menu-wordmark {
    margin: 0;
    padding: 0;
    font-size: 62px;
    -unity-font-style: bold;
    color: #151f36;
}

.menu-wordmark--blue {
    margin-top: -14px;
    color: #234f9d;
}

.menu-actions {
    border-top-width: 1px;
    border-top-color: #a7b6ca;
    margin-top: 18px;
    padding-top: 13px;
}

.menu-button {
    margin: 3px 0;
    height: 41px;
    min-height: 41px;
    font-size: 16px;
}

.menu-button--quit {
    width: 32%;
    min-width: 75px;
    align-self: flex-end;
    font-size: 14px;
}

.menu-status {
    margin: 0;
    color: #9c2b32;
    font-size: 13px;
    white-space: normal;
}
