.l3-boss-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

.retro-title-text {
    flex-grow: 1;
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    margin: 0;
}

.retro-enrage-badge {
    color: #fff5c5;
    background-color: #8e2f33;
    padding: 2px 5px;
    border-radius: 3px;
    font-size: 11px;
    -unity-font-style: bold;
    display: none;
}

.boss-bar-window {
    position: absolute;
    top: 86px;
    width: 418px;
    max-width: 45%;
    display: none;
}

.boss-bar-body {
    padding: 7px;
}

.retro-progress-track {
    height: 14px;
}

.retro-progress-fill {
    background-color: #c44542;
    -unity-background-image-tint-color: #ec6963;
    height: 100%;
    width: 100%;
    transition-property: width;
    transition-duration: 0.12s;
}

.boss-dialog-window {
    position: absolute;
    top: 160px;
    width: 365px;
    max-width: 90%;
    display: none;
}

.dialog-body,
.toast-body {
    padding: 10px;
}

.retro-dialog-text {
    color: #172a50;
    font-size: 13px;
    white-space: normal;
}

.reinforce-toast {
    position: absolute;
    right: 22px;
    bottom: 118px;
    width: 260px;
    max-width: 90%;
    display: none;
}
